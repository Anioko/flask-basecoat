{
 "type": "bar",
 "component": "BarChart",
 "config": {
  "desktop": {
   "label": "Desktop",
   "color": "var(--chart-2)"
  },
  "mobile": {
   "label": "Mobile",
   "color": "var(--chart-2)"
  },
  "label": {
   "color": "var(--background)"
  }
 },
 "data": [
  {
   "month": "January",
   "desktop": 186,
   "mobile": 80
  },
  {
   "month": "February",
   "desktop": 305,
   "mobile": 200
  },
  {
   "month": "March",
   "desktop": 237,
   "mobile": 120
  },
  {
   "month": "April",
   "desktop": 73,
   "mobile": 190
  },
  {
   "month": "May",
   "desktop": 209,
   "mobile": 130
  },
  {
   "month": "June",
   "desktop": 214,
   "mobile": 140
  }
 ],
 "props": {
  "accessibilityLayer": true,
  "layout": "vertical",
  "margin": {
   "right": 16
  }
 },
 "series": [
  {
   "component": "Bar",
   "dataKey": "desktop",
   "fill": "var(--color-desktop)",
   "radius": 4,
   "labelList": [
    {
     "dataKey": "month",
     "position": "insideLeft",
     "offset": 8,
     "className": "fill-(--color-label)",
     "fontSize": 12
    },
    {
     "dataKey": "desktop",
     "position": "right",
     "offset": 8,
     "className": "fill-foreground",
     "fontSize": 12
    }
   ]
  }
 ],
 "axes": [
  {
   "component": "YAxis",
   "dataKey": "month",
   "type": "category",
   "tickLine": false,
   "tickMargin": 10,
   "axisLine": false,
   "tickFormatter": {
    "$fn": "slice",
    "start": 0,
    "end": 3
   },
   "hide": true
  },
  {
   "component": "XAxis",
   "dataKey": "desktop",
   "type": "number",
   "hide": true
  }
 ],
 "grid": {
  "component": "CartesianGrid",
  "horizontal": false
 },
 "tooltip": {
  "cursor": false,
  "indicator": "line",
  "$class": "cn-chart-tooltip grid min-w-32 items-start"
 },
 "legend": null,
 "labels": []
}
