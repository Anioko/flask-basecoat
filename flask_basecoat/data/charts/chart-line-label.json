{
 "type": "line",
 "component": "LineChart",
 "config": {
  "desktop": {
   "label": "Desktop",
   "color": "var(--chart-1)"
  },
  "mobile": {
   "label": "Mobile",
   "color": "var(--chart-2)"
  }
 },
 "data": [
  {
   "month": "January",
   "desktop": 186,
   "mobile": 80
  },
  {
   "month": "February",
   "desktop": 305,
   "mobile": 200
  },
  {
   "month": "March",
   "desktop": 237,
   "mobile": 120
  },
  {
   "month": "April",
   "desktop": 73,
   "mobile": 190
  },
  {
   "month": "May",
   "desktop": 209,
   "mobile": 130
  },
  {
   "month": "June",
   "desktop": 214,
   "mobile": 140
  }
 ],
 "props": {
  "accessibilityLayer": true,
  "margin": {
   "top": 20,
   "left": 12,
   "right": 12
  }
 },
 "series": [
  {
   "component": "Line",
   "dataKey": "desktop",
   "type": "natural",
   "stroke": "var(--color-desktop)",
   "strokeWidth": 2,
   "dot": {
    "fill": "var(--color-desktop)"
   },
   "activeDot": {
    "r": 6
   },
   "labelList": [
    {
     "position": "top",
     "offset": 12,
     "className": "fill-foreground",
     "fontSize": 12
    }
   ]
  }
 ],
 "axes": [
  {
   "component": "XAxis",
   "dataKey": "month",
   "tickLine": false,
   "axisLine": false,
   "tickMargin": 8,
   "tickFormatter": {
    "$fn": "slice",
    "start": 0,
    "end": 3
   }
  }
 ],
 "grid": {
  "component": "CartesianGrid",
  "vertical": false
 },
 "tooltip": {
  "cursor": false,
  "indicator": "line",
  "$class": "cn-chart-tooltip grid min-w-32 items-start"
 },
 "legend": null,
 "labels": []
}
