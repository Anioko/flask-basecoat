      "$fn": "centerText",
      "lines": [
       {
        "value": {
         "pickSum": [
          "desktop",
          "mobile"
         ],
         "index": 0
        },
        "className": "fill-foreground text-2xl font-bold",
        "dy": -16
       },
       {
        "value": {
         "text": "Visitors"
        },
        "className": "fill-muted-foreground",
        "dy": 4
       }
      ]
     }
    }
   ]
  }
 ],
 "grid": null,
