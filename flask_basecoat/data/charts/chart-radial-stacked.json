{
 "type": "radial",
 "component": "RadialBarChart",
 "config": {
  "desktop": {
   "label": "Desktop",
   "color": "var(--chart-1)"
  },
  "mobile": {
   "label": "Mobile",
   "color": "var(--chart-2)"
  }
 },
 "data": [
  {
   "month": "january",
   "mobile": 570,
   "desktop": 1260
  }
 ],
 "props": {
  "endAngle": 180,
  "innerRadius": 80,
  "outerRadius": 110
 },
 "series": [
