{
  "name": "flask-basecoat",
  "version": "1.0.0",
  "description": "A modern Flask application boilerplate with **BasecoatUI** and **Tailwind CSS** - providing a clean, component-based UI similar to shadcn/ui.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:css": "tailwindcss --input app/assets/styles/input.css --output app/static/styles/app.css",
    "watch:css": "tailwindcss --input app/assets/styles/input.css --output app/static/styles/app.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "autoprefixer": "^10.4.21",
    "basecoat-css": "0.3.11",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "postcss-import": "^16.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-cli": "^0.1.2"
  },
  "dependencies": {
    "tinyglobby": "^0.2.17"
  }
}
