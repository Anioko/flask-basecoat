{
  "name": "chart-bar-stacked",
  "group": "bar",
  "fullWidth": false,
  "description": "A stacked bar chart with a legend",
  "card": {
    "title": "Bar Chart - Stacked + Legend",
    "description": "January - June 2024",
    "headerClassName": null,
    "contentClassName": null,
    "footerClassName": "flex-col items-start gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "bar",
    "component": "BarChart",
    "container": {
      "id": null,
      "className": null
    },
    "config": {
      "desktop": {
        "label": "Desktop",
        "color": "var(--chart-1)"
      },
      "mobile": {
        "label": "Mobile",
        "color": "var(--chart-2)"
      }
    },
    "data": [
      {
        "month": "January",
        "desktop": 186,
        "mobile": 80
      },
      {
        "month": "February",
        "desktop": 305,
        "mobile": 200
      },
      {
        "month": "March",
        "desktop": 237,
        "mobile": 120
      },
      {
        "month": "April",
        "desktop": 73,
        "mobile": 190
      },
      {
        "month": "May",
        "desktop": 209,
        "mobile": 130
      },
      {
        "month": "June",
        "desktop": 214,
        "mobile": 140
      }
    ],
    "props": {
      "accessibilityLayer": true
    },
    "series": [
      {
        "component": "Bar",
        "dataKey": "desktop",
        "stackId": "a",
        "fill": "var(--color-desktop)",
        "radius": [
          0,
          0,
          4,
          4
        ]
      },
      {
        "component": "Bar",
        "dataKey": "mobile",
        "stackId": "a",
        "fill": "var(--color-mobile)",
        "radius": [
          4,
          4,
          0,
          0
        ]
      }
    ],
    "axes": [
      {
        "component": "XAxis",
        "dataKey": "month",
        "tickLine": false,
        "tickMargin": 10,
        "axisLine": false,
        "tickFormatter": "(value) => value.slice(0, 3)"
      }
    ],
    "grid": {
      "component": "CartesianGrid",
      "vertical": false
    },
    "tooltip": {
      "content": "ChartTooltipContent",
      "hideLabel": true
    },
    "legend": {
      "content": "ChartLegendContent"
    },
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].tickFormatter"
  ],
  "unresolved": []
}
