{
  "name": "chart-radar-label-custom",
  "group": "radar",
  "fullWidth": false,
  "description": "A radar chart with a custom label",
  "card": {
    "title": "Radar Chart - Custom Label",
    "description": "Showing total visitors for the last 6 months",
    "headerClassName": "items-center pb-4",
    "contentClassName": "pb-0",
    "footerClassName": "flex-col gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex items-center gap-2 leading-none font-medium"
      },
      {
        "text": "January - June 2024",
        "icons": [],
        "className": "flex items-center gap-2 leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "radar",
    "component": "RadarChart",
    "container": {
      "id": null,
      "className": "mx-auto aspect-square max-h-[250px]"
    },
    "config": {
      "desktop": {
        "label": "Desktop",
        "color": "var(--chart-1)"
      },
      "mobile": {
        "label": "Mobile",
        "color": "var(--chart-2)"
      }
    },
    "data": [
      {
        "month": "January",
        "desktop": 186,
        "mobile": 80
      },
      {
        "month": "February",
        "desktop": 305,
        "mobile": 200
      },
      {
        "month": "March",
        "desktop": 237,
        "mobile": 120
      },
      {
        "month": "April",
        "desktop": 73,
        "mobile": 190
      },
      {
        "month": "May",
        "desktop": 209,
        "mobile": 130
      },
      {
        "month": "June",
        "desktop": 214,
        "mobile": 140
      }
    ],
    "props": {
      "margin": {
        "top": 10,
        "right": 10,
        "bottom": 10,
        "left": 10
      }
    },
    "series": [
      {
        "component": "Radar",
        "dataKey": "desktop",
        "fill": "var(--color-desktop)",
        "fillOpacity": 0.6
      },
      {
        "component": "Radar",
        "dataKey": "mobile",
        "fill": "var(--color-mobile)"
      }
    ],
    "axes": [
      {
        "component": "PolarAngleAxis",
        "dataKey": "month",
        "tick": "({ x, y, textAnchor, index, ...props }) => { const data = chartData[index] const yValue = typeof y === \"number\" ? y : 0 return ( <text x={x} y={yValue + (index === 0 ? -10 : 0)} textAnchor={textAnchor} fontSize={13} fontWeight={500} {...props} > <tspan>{data.desktop}</tspan> <tspan className=\"fill-muted-foreground\">/</tspan> <tspan>{data.mobile}</tspan> <tspan x={x} dy={\"1rem\"} fontSize={12} className=\"fill-muted-foreground\" > {data.month} </tspan> </text> ) }"
      }
    ],
    "grid": {
      "component": "PolarGrid"
    },
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "indicator": "line"
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].tick"
  ],
  "unresolved": []
}
