{
  "name": "chart-pie-label-custom",
  "group": "pie",
  "fullWidth": false,
  "description": "A pie chart with a custom label",
  "card": {
    "props": {
      "className": "flex flex-col"
    },
    "title": "Pie Chart - Custom Label",
    "description": "January - June 2024",
    "headerClassName": "items-center pb-0",
    "contentClassName": "flex-1 pb-0",
    "footerClassName": "flex-col gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex items-center gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "pie",
    "component": "PieChart",
    "container": {
      "id": null,
      "className": "mx-auto aspect-square max-h-[250px] px-0"
    },
    "config": {
      "visitors": {
        "label": "Visitors"
      },
      "chrome": {
        "label": "Chrome",
        "color": "var(--chart-1)"
      },
      "safari": {
        "label": "Safari",
        "color": "var(--chart-2)"
      },
      "firefox": {
        "label": "Firefox",
        "color": "var(--chart-3)"
      },
      "edge": {
        "label": "Edge",
        "color": "var(--chart-4)"
      },
      "other": {
        "label": "Other",
        "color": "var(--chart-5)"
      }
    },
    "data": null,
    "props": {},
    "series": [
      {
        "component": "Pie",
        "data": [
          {
            "browser": "chrome",
            "visitors": 275,
            "fill": "var(--color-chrome)"
          },
          {
            "browser": "safari",
            "visitors": 200,
            "fill": "var(--color-safari)"
          },
          {
            "browser": "firefox",
            "visitors": 187,
            "fill": "var(--color-firefox)"
          },
          {
            "browser": "edge",
            "visitors": 173,
            "fill": "var(--color-edge)"
          },
          {
            "browser": "other",
            "visitors": 90,
            "fill": "var(--color-other)"
          }
        ],
        "dataKey": "visitors",
        "labelLine": false,
        "label": "({ payload, ...props }) => { return ( <text cx={props.cx} cy={props.cy} x={props.x} y={props.y} textAnchor={props.textAnchor} dominantBaseline={props.dominantBaseline} fill=\"var(--foreground)\" > {payload.visitors} </text> ) }",
        "nameKey": "browser"
      }
    ],
    "axes": [],
    "grid": null,
    "tooltip": {
      "content": "ChartTooltipContent",
      "nameKey": "visitors",
      "hideLabel": true
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.series[0].label"
  ],
  "unresolved": []
}
