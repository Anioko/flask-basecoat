{
  "name": "chart-area-stacked-expand",
  "group": "area",
  "fullWidth": false,
  "description": "A stacked area chart with expand stacking",
  "card": {
    "title": "Area Chart - Stacked Expanded",
    "description": "Showing total visitors for the last 6months",
    "headerClassName": null,
    "contentClassName": null,
    "footerClassName": null,
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex items-center gap-2 leading-none font-medium",
        "wrappers": [
          "flex w-full items-start gap-2 text-sm",
          "grid gap-2"
        ]
      },
      {
        "text": "January - June 2024",
        "icons": [],
        "className": "flex items-center gap-2 leading-none text-muted-foreground",
        "wrappers": [
          "flex w-full items-start gap-2 text-sm",
          "grid gap-2"
        ]
      }
    ]
  },
  "chart": {
    "type": "area",
    "component": "AreaChart",
    "container": {
      "id": null,
      "className": null
    },
    "config": {
      "desktop": {
        "label": "Desktop",
        "color": "var(--chart-1)"
      },
      "mobile": {
        "label": "Mobile",
        "color": "var(--chart-2)"
      },
      "other": {
        "label": "Other",
        "color": "var(--chart-3)"
      }
    },
    "data": [
      {
        "month": "January",
        "desktop": 186,
        "mobile": 80,
        "other": 45
      },
      {
        "month": "February",
        "desktop": 305,
        "mobile": 200,
        "other": 100
      },
      {
        "month": "March",
        "desktop": 237,
        "mobile": 120,
        "other": 150
      },
      {
        "month": "April",
        "desktop": 73,
        "mobile": 190,
        "other": 50
      },
      {
        "month": "May",
        "desktop": 209,
        "mobile": 130,
        "other": 100
      },
      {
        "month": "June",
        "desktop": 214,
        "mobile": 140,
        "other": 160
      }
    ],
    "props": {
      "accessibilityLayer": true,
      "margin": {
        "left": 12,
        "right": 12,
        "top": 12
      },
      "stackOffset": "expand"
    },
    "series": [
      {
        "component": "Area",
        "dataKey": "other",
        "type": "natural",
        "fill": "var(--color-other)",
        "fillOpacity": 0.1,
        "stroke": "var(--color-other)",
        "stackId": "a"
      },
      {
        "component": "Area",
        "dataKey": "mobile",
        "type": "natural",
        "fill": "var(--color-mobile)",
        "fillOpacity": 0.4,
        "stroke": "var(--color-mobile)",
        "stackId": "a"
      },
      {
        "component": "Area",
        "dataKey": "desktop",
        "type": "natural",
        "fill": "var(--color-desktop)",
        "fillOpacity": 0.4,
        "stroke": "var(--color-desktop)",
        "stackId": "a"
      }
    ],
    "axes": [
      {
        "component": "XAxis",
        "dataKey": "month",
        "tickLine": false,
        "axisLine": false,
        "tickMargin": 8,
        "tickFormatter": "(value) => value.slice(0, 3)"
      }
    ],
    "grid": {
      "component": "CartesianGrid",
      "vertical": false
    },
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "indicator": "line"
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].tickFormatter"
  ],
  "unresolved": []
}
