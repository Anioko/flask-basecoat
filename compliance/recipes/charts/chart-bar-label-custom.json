{
  "name": "chart-bar-label-custom",
  "group": "bar",
  "fullWidth": false,
  "description": "A bar chart with a custom label",
  "card": {
    "title": "Bar Chart - Custom Label",
    "description": "January - June 2024",
    "headerClassName": null,
    "contentClassName": null,
    "footerClassName": "flex-col items-start gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "bar",
    "component": "BarChart",
    "container": {
      "id": null,
      "className": null
    },
    "config": {
      "desktop": {
        "label": "Desktop",
        "color": "var(--chart-2)"
      },
      "mobile": {
        "label": "Mobile",
        "color": "var(--chart-2)"
      },
      "label": {
        "color": "var(--background)"
      }
    },
    "data": [
      {
        "month": "January",
        "desktop": 186,
        "mobile": 80
      },
      {
        "month": "February",
        "desktop": 305,
        "mobile": 200
      },
      {
        "month": "March",
        "desktop": 237,
        "mobile": 120
      },
      {
        "month": "April",
        "desktop": 73,
        "mobile": 190
      },
      {
        "month": "May",
        "desktop": 209,
        "mobile": 130
      },
      {
        "month": "June",
        "desktop": 214,
        "mobile": 140
      }
    ],
    "props": {
      "accessibilityLayer": true,
      "layout": "vertical",
      "margin": {
        "right": 16
      }
    },
    "series": [
      {
        "component": "Bar",
        "dataKey": "desktop",
        "fill": "var(--color-desktop)",
        "radius": 4,
        "labelList": [
          {
            "dataKey": "month",
            "position": "insideLeft",
            "offset": 8,
            "className": "fill-(--color-label)",
            "fontSize": 12
          },
          {
            "dataKey": "desktop",
            "position": "right",
            "offset": 8,
            "className": "fill-foreground",
            "fontSize": 12
          }
        ]
      }
    ],
    "axes": [
      {
        "component": "YAxis",
        "dataKey": "month",
        "type": "category",
        "tickLine": false,
        "tickMargin": 10,
        "axisLine": false,
        "tickFormatter": "(value) => value.slice(0, 3)",
        "hide": true
      },
      {
        "component": "XAxis",
        "dataKey": "desktop",
        "type": "number",
        "hide": true
      }
    ],
    "grid": {
      "component": "CartesianGrid",
      "horizontal": false
    },
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "indicator": "line"
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].tickFormatter"
  ],
  "unresolved": []
}
