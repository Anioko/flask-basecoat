{
  "name": "chart-bar-mixed",
  "group": "bar",
  "fullWidth": false,
  "description": "A mixed bar chart",
  "card": {
    "title": "Bar Chart - Mixed",
    "description": "January - June 2024",
    "headerClassName": null,
    "contentClassName": null,
    "footerClassName": "flex-col items-start gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "bar",
    "component": "BarChart",
    "container": {
      "id": null,
      "className": null
    },
    "config": {
      "visitors": {
        "label": "Visitors"
      },
      "chrome": {
        "label": "Chrome",
        "color": "var(--chart-1)"
      },
      "safari": {
        "label": "Safari",
        "color": "var(--chart-2)"
      },
      "firefox": {
        "label": "Firefox",
        "color": "var(--chart-3)"
      },
      "edge": {
        "label": "Edge",
        "color": "var(--chart-4)"
      },
      "other": {
        "label": "Other",
        "color": "var(--chart-5)"
      }
    },
    "data": [
      {
        "browser": "chrome",
        "visitors": 275,
        "fill": "var(--color-chrome)"
      },
      {
        "browser": "safari",
        "visitors": 200,
        "fill": "var(--color-safari)"
      },
      {
        "browser": "firefox",
        "visitors": 187,
        "fill": "var(--color-firefox)"
      },
      {
        "browser": "edge",
        "visitors": 173,
        "fill": "var(--color-edge)"
      },
      {
        "browser": "other",
        "visitors": 90,
        "fill": "var(--color-other)"
      }
    ],
    "props": {
      "accessibilityLayer": true,
      "layout": "vertical",
      "margin": {
        "left": 0
      }
    },
    "series": [
      {
        "component": "Bar",
        "dataKey": "visitors",
        "radius": 5
      }
    ],
    "axes": [
      {
        "component": "YAxis",
        "dataKey": "browser",
        "type": "category",
        "tickLine": false,
        "tickMargin": 10,
        "axisLine": false,
        "tickFormatter": "(value) => chartConfig[value as keyof typeof chartConfig]?.label"
      },
      {
        "component": "XAxis",
        "dataKey": "visitors",
        "type": "number",
        "hide": true
      }
    ],
    "grid": null,
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "hideLabel": true
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].tickFormatter"
  ],
  "unresolved": []
}
