{
  "name": "chart-tooltip-label-custom",
  "group": "tooltip",
  "fullWidth": false,
  "description": "A stacked bar chart with a legend",
  "card": {
    "title": "Tooltip - Custom label",
    "description": "Tooltip with custom label from chartConfig.",
    "headerClassName": null,
    "contentClassName": null,
    "footer": []
  },
  "chart": {
    "type": "bar",
    "component": "BarChart",
    "container": {
      "id": null,
      "className": null
    },
    "config": {
      "activities": {
        "label": "Activities"
      },
      "running": {
        "label": "Running",
        "color": "var(--chart-1)"
      },
      "swimming": {
        "label": "Swimming",
        "color": "var(--chart-2)"
      }
    },
    "data": [
      {
        "date": "2024-07-15",
        "running": 450,
        "swimming": 300
      },
      {
        "date": "2024-07-16",
        "running": 380,
        "swimming": 420
      },
      {
        "date": "2024-07-17",
        "running": 520,
        "swimming": 120
      },
      {
        "date": "2024-07-18",
        "running": 140,
        "swimming": 550
      },
      {
        "date": "2024-07-19",
        "running": 600,
        "swimming": 350
      },
      {
        "date": "2024-07-20",
        "running": 480,
        "swimming": 400
      }
    ],
    "props": {
