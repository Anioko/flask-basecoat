{
  "name": "chart-radial-stacked",
  "group": "radial",
  "fullWidth": false,
  "description": "A radial chart with stacked sections",
  "card": {
    "props": {
      "className": "flex flex-col"
    },
    "title": "Radial Chart - Stacked",
    "description": "January - June 2024",
    "headerClassName": "items-center pb-0",
    "contentClassName": "flex flex-1 items-center pb-0",
    "footerClassName": "flex-col gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex items-center gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "radial",
    "component": "RadialBarChart",
    "container": {
      "id": null,
      "className": "mx-auto aspect-square w-full max-w-[250px]"
    },
    "config": {
      "desktop": {
        "label": "Desktop",
        "color": "var(--chart-1)"
      },
      "mobile": {
        "label": "Mobile",
        "color": "var(--chart-2)"
      }
    },
    "data": [
      {
        "month": "january",
        "mobile": 570,
        "desktop": 1260
      }
    ],
    "props": {
      "endAngle": 180,
      "innerRadius": 80,
      "outerRadius": 110
    },
    "series": [
      {
        "component": "RadialBar",
        "dataKey": "mobile",
        "fill": "var(--color-mobile)",
        "stackId": "a",
        "cornerRadius": 5,
        "className": "stroke-transparent stroke-2"
      },
      {
        "component": "RadialBar",
        "dataKey": "desktop",
        "stackId": "a",
        "cornerRadius": 5,
        "fill": "var(--color-desktop)",
        "className": "stroke-transparent stroke-2"
      }
    ],
    "axes": [
      {
        "component": "PolarRadiusAxis",
        "tick": false,
        "tickLine": false,
        "axisLine": false,
        "labels": [
          {
            "content": "({ viewBox }) => { if (viewBox && \"cx\" in viewBox && \"cy\" in viewBox) { return ( <text x={viewBox.cx} y={viewBox.cy} textAnchor=\"middle\"> <tspan x={viewBox.cx} y={(viewBox.cy || 0) - 16} className=\"fill-foreground text-2xl font-bold\" > {totalVisitors.toLocaleString()} </tspan> <tspan x={viewBox.cx} y={(viewBox.cy || 0) + 4} className=\"fill-muted-foreground\" > Visitors </tspan> </text> ) } }"
          }
        ]
      }
    ],
    "grid": null,
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "hideLabel": true
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [
    "chart.axes[0].labels[0].content"
  ],
  "unresolved": []
}
