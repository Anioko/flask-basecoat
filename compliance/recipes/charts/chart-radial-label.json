{
  "name": "chart-radial-label",
  "group": "radial",
  "fullWidth": false,
  "description": "A radial chart with a label",
  "card": {
    "props": {
      "className": "flex flex-col"
    },
    "title": "Radial Chart - Label",
    "description": "January - June 2024",
    "headerClassName": "items-center pb-0",
    "contentClassName": "flex-1 pb-0",
    "footerClassName": "flex-col gap-2 text-sm",
    "footer": [
      {
        "text": "Trending up by 5.2% this month",
        "icons": [
          "trending-up"
        ],
        "className": "flex items-center gap-2 leading-none font-medium"
      },
      {
        "text": "Showing total visitors for the last 6 months",
        "icons": [],
        "className": "leading-none text-muted-foreground"
      }
    ]
  },
  "chart": {
    "type": "radial",
    "component": "RadialBarChart",
    "container": {
      "id": null,
      "className": "mx-auto aspect-square max-h-[250px]"
    },
    "config": {
      "visitors": {
        "label": "Visitors"
      },
      "chrome": {
        "label": "Chrome",
        "color": "var(--chart-1)"
      },
      "safari": {
        "label": "Safari",
        "color": "var(--chart-2)"
      },
      "firefox": {
        "label": "Firefox",
        "color": "var(--chart-3)"
      },
      "edge": {
        "label": "Edge",
        "color": "var(--chart-4)"
      },
      "other": {
        "label": "Other",
        "color": "var(--chart-5)"
      }
    },
    "data": [
      {
        "browser": "chrome",
        "visitors": 275,
        "fill": "var(--color-chrome)"
      },
      {
        "browser": "safari",
        "visitors": 200,
        "fill": "var(--color-safari)"
      },
      {
        "browser": "firefox",
        "visitors": 187,
        "fill": "var(--color-firefox)"
      },
      {
        "browser": "edge",
        "visitors": 173,
        "fill": "var(--color-edge)"
      },
      {
        "browser": "other",
        "visitors": 90,
        "fill": "var(--color-other)"
      }
    ],
    "props": {
      "startAngle": -90,
      "endAngle": 380,
      "innerRadius": 30,
      "outerRadius": 110
    },
    "series": [
      {
        "component": "RadialBar",
        "dataKey": "visitors",
        "background": true,
        "labelList": [
          {
            "position": "insideStart",
            "dataKey": "browser",
            "className": "fill-white capitalize mix-blend-luminosity",
            "fontSize": 11
          }
        ]
      }
    ],
    "axes": [],
    "grid": null,
    "tooltip": {
      "cursor": false,
      "content": "ChartTooltipContent",
      "hideLabel": true,
      "nameKey": "browser"
    },
    "legend": null,
    "labels": []
  },
  "interactive": null,
  "functionProps": [],
  "unresolved": []
}
