{
  "name": "flask-basecoat-golden-oracle",
  "private": true,
  "type": "module",
  "description": "Renders the pinned upstream shadcn/ui React components to static HTML so computed styles can be compared against flask-basecoat macros.",
  "scripts": {
    "render": "tsx render.tsx",
    "css": "tailwindcss -i golden.css -o out/golden.css --minify",
    "charts:bundle": "node charts/build.mjs",
    "charts:render": "python charts/render_charts.py",
    "charts": "npm run css && npm run charts:bundle && npm run charts:render && npm run css"
  },
  "devDependencies": {
    "@base-ui/react": "latest",
    "@hookform/resolvers": "^5",
    "@shadcn/react": "0.3.1",
    "@tailwindcss/cli": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1",
    "cn": "0.5.0",
    "date-fns": "^4",
    "embla-carousel-react": "^8",
    "input-otp": "^1",
    "lucide-react": "latest",
    "next-themes": "^0.4",
    "radix-ui": "1.8.1",
    "react": "^19",
    "react-day-picker": "latest",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2",
    "tailwindcss": "^4",
    "tsx": "^4",
    "tw-animate-css": "^1",
    "typescript": "^5",
    "vaul": "^1",
    "zod": "^4"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.156",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@shadcn/helpers": "^0.3.0",
    "@tanstack/react-table": "^9.3.1",
    "ai": "^7.0.152",
    "axe-core": "^4.14.0",
    "chrono-node": "2.8.2",
    "lucide-static": "^1.61.0",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.1"
  }
}
